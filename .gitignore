*.jks
*.keystore
google-services.json
secrets.properties
*.key
*.pem

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# KSP generated
ksp/

